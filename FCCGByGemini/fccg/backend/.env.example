# 백엔드 환경 변수 예제
# 실제 배포 시 .env 파일을 생성하고 아래 값들을 설정하세요

# 서버 포트 (기본값: 4000)
PORT=4000

# 데이터베이스 연결 문자열 (Prisma)
# 예: postgresql://user:password@host:port/database
# 예: file:./dev.db (SQLite)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT 토큰 서명 키 (반드시 강력한 랜덤 문자열 사용, 최소 32자 권장)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters

# Cloudinary 설정 (갤러리 이미지 업로드용)
# Cloudinary 계정 생성 후 아래 값들을 설정하세요
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 이메일 발송 설정
GMAIL_USER=your_gmail_address@gmail.com

# Render 무료 서비스 권장: Gmail API(HTTPS)
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token

# 로컬 또는 SMTP 포트가 허용된 유료 서버의 보조 방식
GMAIL_APP_PASSWORD=your_gmail_app_password

# 자동 경기 알림 (서버 크론) 활성화 여부
# true: 매일 10시(당일), 15시(전날) 경기 알림 발송
AUTO_GAME_REMINDER_ENABLED=true

# 자동 투표 독려 메일
# true: 매주 목요일 10:00~11:59(KST)에 투표 미참여 활성 회원에게 1회 발송
AUTO_VOTE_REMINDER_ENABLED=true

# 무료 Render를 외부 스케줄러가 안전하게 깨울 때 사용할 임의의 긴 비밀값
CRON_SECRET=replace_with_a_long_random_secret

# 회원 자동 상태 규칙 누적 시작 시각(ISO 8601)
# 이 시각 이전의 투표·경기·미로그인 기록은 소급 제재하지 않습니다.
MEMBER_STATUS_RULES_START_AT=2026-07-16T06:46:00.000Z

# 카카오맵 API 키 (선택사항)
KAKAO_MAP_API_KEY=your_kakao_map_api_key

# 공휴일 API 키 (선택사항)
PUBLIC_DATA_API_KEY=your_public_data_api_key

# CORS 설정 (선택사항)
FRONTEND_URL=https://your-frontend-domain.vercel.app
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Node 환경 (development, production)
NODE_ENV=production
